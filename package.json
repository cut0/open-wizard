{
  "name": "open-wizard",
  "version": "0.0.2",
  "description": "Converting Open API Schemas",
  "main": "index.js",
  "bin": {
    "open-wizard": "./dist/cli/index.js"
  },
  "scripts": {
    "lint:check": "biome ci",
    "lint:fix": "biome check --fix",
    "typecheck": "tsc --noEmit",
    "build": "tsx ./build.ts",
    "dev": "tsx ./src/cli/main.ts",
    "prd": "pnpm build && node ./dist/cli/index.js",
    "test": "vitest",
    "release": "pnpm build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cut0/open-wizard.git"
  },
  "keywords": [
    "OpenAPI"
  ],
  "author": "Cut0",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cut0/open-wizard/issues"
  },
  "homepage": "https://github.com/cut0/open-wizard#readme",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/changelog-github": "0.5.0",
    "@changesets/cli": "2.28.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.10.10",
    "esbuild": "0.25.0",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  },
  "dependencies": {
    "commander": "13.1.0",
    "js-yaml": "4.1.0",
    "openapi-types": "12.1.3",
    "tsx": "4.19.2"
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6"
}
